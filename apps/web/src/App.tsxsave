import { useState, useEffect } from 'react';
import { useAuthStore } from './store/authStore';
import { getMe } from './api/auth';
import { connectStrava } from './api/strava';
import AuthScreen from './screens/AuthScreen';
import HomeScreen from './screens/HomeScreen';
import FoodScreen from './screens/FoodScreen';
import ProfileSetupScreen from './screens/ProfileSetupScreen';

type Tab = 'home' | 'food' | 'profile';

const TABS: Array<{ id: Tab; label: string }> = [
  { id: 'home',    label: 'HOME' },
  { id: 'food',    label: 'FUEL' },
  { id: 'profile', label: 'YOU' },
];

export default function App() {
  const { user, hasToken, setAuth, setUser, logout } = useAuthStore();
  const [activeTab,        setActiveTab]        = useState<Tab>('home');
  const [booting,          setBooting]          = useState(true);
  const [stravaConnecting, setStravaConnecting] = useState(false);

  useEffect(() => {
    if (!hasToken) { setBooting(false); return; }
    getMe().then(setUser).catch(() => logout()).finally(() => setBooting(false));
  }, []);

  useEffect(() => {
    if (!user) return;
    const params = new URLSearchParams(window.location.search);
    const code  = params.get('code');
    const scope = params.get('scope');
    if (!code || !scope?.includes('activity')) return;
    window.history.replaceState({}, '', window.location.pathname);
    setStravaConnecting(true);
    connectStrava(code).catch(() => {}).finally(() => { setStravaConnecting(false); setActiveTab('home'); });
  }, [user]);

  if (booting || stravaConnecting) {
    return (
      <div style={{ height: '100dvh', display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', background: '#000' }}>
        <div className="nrc-hero" style={{ fontSize: 56, color: '#fff' }}>
          FUEL<span style={{ color: '#D0FF00' }}>SYNC</span>
        </div>
        <div style={{ color: 'rgba(255,255,255,0.3)', fontSize: 11, letterSpacing: 3, marginTop: 16, fontFamily: "'Barlow Condensed', sans-serif", fontStyle: 'italic' }}>
          {stravaConnecting ? 'CONNECTING STRAVA' : 'LOADING'}
        </div>
      </div>
    );
  }

  if (!hasToken || !user) return <AuthScreen />;

  const NAV_H = 72;

  return (
    <div style={{
      position: 'relative', height: '100dvh',
      maxWidth: 480, margin: '0 auto', background: '#000', overflow: 'hidden',
    }}>
      {/* Screens — pad bottom so content clears glassmorphism nav */}
      <div style={{ position: 'absolute', inset: 0, bottom: NAV_H, overflow: 'hidden' }}>
        {activeTab === 'home'    && <HomeScreen />}
        {activeTab === 'food'    && <FoodScreen />}
        {activeTab === 'profile' && <ProfileSetupScreen />}
      </div>

      {/* Glassmorphism nav */}
      <nav style={{
        position: 'absolute', bottom: 0, left: 0, right: 0,
        height: NAV_H,
        backdropFilter: 'blur(24px) saturate(180%)',
        WebkitBackdropFilter: 'blur(24px) saturate(180%)',
        background: 'rgba(0,0,0,0.82)',
        borderTop: '1px solid rgba(255,255,255,0.07)',
        display: 'flex',
        paddingBottom: 'env(safe-area-inset-bottom, 0px)',
        zIndex: 50,
      }}>
        {TABS.map(({ id, label }) => {
          const active = activeTab === id;
          return (
            <button key={id} onClick={() => setActiveTab(id)} className="nrc-press" style={{
              flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center',
              justifyContent: 'center', gap: 6, background: 'none', border: 'none',
              padding: '10px 0',
            }}>
              {/* Active indicator — volt dot */}
              <div style={{
                width: active ? 24 : 6, height: 3, borderRadius: 2,
                background: active ? '#D0FF00' : 'rgba(255,255,255,0.15)',
                transition: 'width 0.3s var(--spring), background 0.2s',
              }} />
              <span style={{
                fontFamily: "'Barlow Condensed', sans-serif",
                fontWeight: 900, fontStyle: 'italic',
                fontSize: 13, letterSpacing: 1.5,
                color: active ? '#D0FF00' : 'rgba(255,255,255,0.25)',
                transition: 'color 0.2s',
              }}>
                {label}
              </span>
            </button>
          );
        })}
      </nav>
    </div>
  );
}
