{
  "expo": {
    "name": "FuelSync",
    "slug": "fuelsync",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0d0d1a"
    },
    "plugins": ["expo-location"],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d1a"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FuelSync uses your location to assess outdoor training conditions."
      }
    }
  }
}
